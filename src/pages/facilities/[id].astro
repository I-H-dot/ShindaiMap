---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryMap } from "../../data/categories";
import { facilities } from "../../data/facilities";
import { withBasePath } from "../../lib/urls";

export function getStaticPaths() {
  return facilities.map((facility) => ({
    params: { id: facility.id },
    props: { facility }
  }));
}

const { facility } = Astro.props;
const category = categoryMap.get(facility.category);
const description = `${facility.name} | ${facility.campus} | 神大Map`;
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${facility.position.lat},${facility.position.lng}`;
const appleMapsUrl = `https://maps.apple.com/?ll=${facility.position.lat},${facility.position.lng}&q=${encodeURIComponent(facility.name)}`;
---
<BaseLayout title={`${facility.name} | 神大Map`} description={description} canonicalPath={`/facilities/${facility.id}/`}>
  <main class="article-page">
    <a class="article-back" href={withBasePath(`/?facility=${facility.id}`)}>地図で見る</a>
    <section class="article-hero">
      <p class="eyebrow">{facility.campus} / {category?.label}</p>
      <h1>{facility.name}</h1>
      <div class="article-actions">
        <a href={googleMapsUrl} target="_blank" rel="noreferrer">Google Mapsで開く</a>
        <a href={appleMapsUrl} target="_blank" rel="noreferrer">Apple Mapsで開く</a>
      </div>
    </section>
    <section class="article-section">
      <h2>探すときの目印</h2>
      <dl class="detail-list">
        <div>
          <dt>キャンパス</dt>
          <dd>{facility.campus}</dd>
        </div>
        <div>
          <dt>エリア</dt>
          <dd>{facility.area}</dd>
        </div>
        {facility.building && (
          <div>
            <dt>建物</dt>
            <dd>{facility.building}</dd>
          </div>
        )}
        {facility.openHours && (
          <div>
            <dt>時間</dt>
            <dd>{facility.openHours}</dd>
          </div>
        )}
      </dl>
    </section>
  </main>
</BaseLayout>
