---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShindaiMapApp from "../components/ShindaiMapApp";
import { categories } from "../data/categories";
import { campusCenters, facilities } from "../data/facilities";

const description =
  "神大Mapは、神戸大学の公式地図番号、AED、駐輪場、ATM、ポスト、食堂・売店、バス停、鉄道駅を1画面で探せるキャンパスマップです。";
---
<BaseLayout title="神大Map | 神戸大学キャンパスマップ" description={description} canonicalPath="/">
  <ShindaiMapApp
    client:load
    initialFacilities={facilities}
    categories={categories}
    campusCenters={campusCenters}
  />
</BaseLayout>
