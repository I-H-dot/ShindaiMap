---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShindaiMapApp from "../components/ShindaiMapApp";
import { categories } from "../data/categories";
import { campusCenters, facilities } from "../data/facilities";

const description =
  "神大Map（神大マップ）は、神戸大学の地図・キャンパスマップです。公式地図番号、教室、AED、駐輪場、ATM、食堂・売店、バス停、鉄道駅を1画面で探せます。";
---
<BaseLayout title="神大Map（神大マップ）| 神戸大学 地図・キャンパスマップ" description={description} canonicalPath="/">
  <ShindaiMapApp
    client:load
    initialFacilities={facilities}
    categories={categories}
    campusCenters={campusCenters}
  />
</BaseLayout>
