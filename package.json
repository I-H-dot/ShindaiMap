{
  "name": "shindai-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial open-source campus map for Kobe University.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/I-H-dot/ShindaiMap.git"
  },
  "bugs": {
    "url": "https://github.com/I-H-dot/ShindaiMap/issues"
  },
  "homepage": "https://i-h-dot.github.io/ShindaiMap/",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check": "npm run test && npm run build",
    "scrape:train-timetables": "python3 scraiping/trainScheduleGetter.py --output src/data/generated/trainTimetables.ts"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.6.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@googlemaps/js-api-loader": "^2.1.0",
    "astro": "^7.0.4",
    "fuse.js": "^7.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "yaml-language-server": {
      "yaml": "^2.8.3"
    }
  },
  "packageManager": "npm@11.6.2"
}
